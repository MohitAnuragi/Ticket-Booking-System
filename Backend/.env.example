
DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
DB_USER=postgres
DB_PASSWORD=

DB_POOL_SIZE=5


JWT_SECRET=

# Optional JWT tuning
JWT_ISSUER=ticket-booking-system
JWT_AUDIENCE=ticket-booking-users
JWT_EXPIRY_HOURS=24


ADMIN_BOOTSTRAP_EMAIL=admin@ticketbooking.local
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Platform Admin


HOLD_TTL_HOURS=24
# How often the background sweeper releases expired holds, in minutes.
HOLD_SWEEP_INTERVAL_MINUTES=5
# Maximum seats a single booking may contain.
MAX_SEATS_PER_BOOKING=10


# ---------------------------------------------------------------------------
# SERVER (optional)
# ---------------------------------------------------------------------------
PORT=8080
